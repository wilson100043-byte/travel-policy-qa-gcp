# The app does not load this file automatically. Local defaults already work.
# To use a copy: set -a; source .env; set +a
AI_MODE=local
STORAGE_MODE=local

# Optional local overrides:
# POLICY_DOCS_DIR=policy_docs
# INDEX_PATH=data/processed/index.json
# WEB_DIR=web

# Cloud settings, normally set by Terraform on Cloud Run. Vertex AI uses the
# runtime service account (or your gcloud login locally); no API key is needed.
# AI_MODE=vertex
# GOOGLE_CLOUD_PROJECT=
# VERTEX_LOCATION=asia-east1
# VERTEX_GENERATION_MODEL=gemini-2.5-flash-lite
# VERTEX_EMBEDDING_MODEL=gemini-embedding-001
# STORAGE_MODE=gcs
# GCS_BUCKET=
# GCS_RAW_PREFIX=raw/
# GCS_PROCESSED_OBJECT=processed/index.json
