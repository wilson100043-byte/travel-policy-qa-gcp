# The app does not load this file automatically. Local defaults already work.
# To use a copy: set -a; source .env; set +a
AI_MODE=local
STORAGE_MODE=local

# Optional local overrides:
# POLICY_DOCS_DIR=policy_docs
# INDEX_PATH=data/processed/index.json
# WEB_DIR=web

# Remote Gemini/GCP settings are intentionally disabled in this example.
# Do not set AI_MODE=gemini without first verifying your own Free Tier account.
# AI_MODE=gemini
# GEMINI_API_KEY=
# GEMINI_FREE_TIER_CONFIRMED=0
# GCS_BUCKET=
# GCS_RAW_PREFIX=raw/
# GCS_PROCESSED_OBJECT=processed/index.json
