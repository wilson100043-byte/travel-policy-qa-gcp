        <mxCell id="registry-job" value="提供映像" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7750BF;strokeWidth=3;endArrow=block;endFill=1;fontColor=#7750BF;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=9 7;" edge="1" parent="1" source="registry" target="job">
