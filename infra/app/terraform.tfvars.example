project_id  = "YOUR_GCP_PROJECT_ID"
bucket_name = "YOUR_GLOBALLY_UNIQUE_BUCKET_NAME"
region      = "asia-east1"
image_uri   = "asia-east1-docker.pkg.dev/YOUR_GCP_PROJECT_ID/travel-policy-rag/app:YOUR_IMMUTABLE_TAG"

service_name = "travel-policy-rag"
job_name     = "travel-policy-rag-index"

# Vertex AI answers by default. These model and location pairs are confirmed in
# Google's docs; AI inference is processed in the United States.
ai_mode                   = "vertex"
vertex_location           = "us"
vertex_embedding_location = "us-central1"
generation_model          = "gemini-3.5-flash-lite"
embedding_model           = "gemini-embedding-001"

# Peak capacity: max_instances x request_concurrency concurrent requests.
min_instances       = 1
max_instances       = 5
request_concurrency = 10

# Employees who may sign in through IAP.
authorized_users = ["group:all-staff@example.com"]
# Administration team who may upload policies to raw/.
policy_admins = ["group:admin-dept@example.com"]
# Maintainers who may run the index Job by hand.
authorized_job_executors = ["group:it-ops@example.com"]
# Receives monitoring alerts.
alert_email = "it-ops@example.com"
