project_id  = "YOUR_GCP_PROJECT_ID"
bucket_name = "YOUR_GLOBALLY_UNIQUE_BUCKET_NAME"
region      = "us-central1"
image_uri   = "us-central1-docker.pkg.dev/YOUR_GCP_PROJECT_ID/travel-policy-rag/app:YOUR_IMMUTABLE_TAG"

service_name = "travel-policy-rag"
job_name     = "travel-policy-rag-index"
secret_id    = "travel-rag-gemini-api-key"

# Safe default: no Gemini calls and no secret version required.
ai_mode                    = "offline"
gemini_free_tier_confirmed = false

# People who may sign in through IAP and use the web page (user: or group:).
authorized_users = ["user:YOUR_EMAIL@example.com"]
# People who may run the manual indexing Job.
authorized_job_executors = ["user:YOUR_EMAIL@example.com"]
